# =====================================================================
# VYRA DEPLOYMENT CONFIGURATION — copy to .env for server-only delivery.
# Public identity and public links are intentionally hardcoded in content/site.ts.
# NEVER commit .env to git.
# =====================================================================

# The public site origin is currently configured in content/site.ts.
# These legacy NEXT_PUBLIC_* variables do not change VYRA branding or public links.

# --- Contact form delivery (server-side only) ---
# Set both values to enable secure server-side contact-form delivery.
# NEVER prefix server secrets with NEXT_PUBLIC_.
CONTACT_TO_EMAIL=""
RESEND_API_KEY=""

# --- Optional GitHub enrichment (server-side only) ---
# If empty, the site renders static technical reference content.
GITHUB_TOKEN=""
