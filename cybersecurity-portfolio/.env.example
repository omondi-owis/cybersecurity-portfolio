# =====================================================================
# VYRA DEPLOYMENT CONFIGURATION — copy to .env for server-only delivery.
# Public identity and public links are intentionally hardcoded in content/site.ts.
# NEVER commit .env to git.
# =====================================================================

# The public site origin is currently configured in content/site.ts.
# These legacy NEXT_PUBLIC_* variables do not change VYRA branding or public links.

# --- Contact form delivery (server-side only) ---
# Set both values to enable secure server-side contact-form delivery.
# NEVER prefix server secrets with NEXT_PUBLIC_.
CONTACT_TO_EMAIL=""
RESEND_API_KEY=""

# --- Optional GitHub enrichment (server-side only) ---
# If empty, the site renders static technical reference content.
GITHUB_TOKEN=""

# --- Vercel KV compatibility (server-side only) ---
# Optional alternative to the Upstash variables below. Provide both KV values,
# only when no UPSTASH_REDIS_REST_* values are configured.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# --- Required shared rate limits (server-only; never NEXT_PUBLIC_) ---
# Same writable database, secret and namespace across every production instance.
# Use separate values for preview/test. No local-memory fallback.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Generate a random secret with at least 32 characters. Never commit the value.
RATE_LIMIT_HMAC_SECRET=""
RATE_LIMIT_NAMESPACE="vyra:production:rate:v1"
# On Vercel the platform IP header is used. Otherwise leave blank to group
# requests as unknown; set ONLY behind a proxy that overwrites this header.
RATE_LIMIT_TRUSTED_IP_HEADER=""

# --- Optional persisted enquiries + private dashboard (disabled by default) ---
# Provision a free Neon PostgreSQL database, apply migrations/001_enquiries.sql first,
# then set all values. Do not use NEXT_PUBLIC_ names for any of these.
ENQUIRY_DASHBOARD_ENABLED="false"
DATABASE_URL=""
ADMIN_EMAIL=""
ADMIN_AUTH_SECRET=""
# Exact canonical HTTPS public origin. Origin checks never trust request Host.
SITE_URL="https://example.com"
# Keep this scheduler secret outside public requests; see docs/ENQUIRY_DASHBOARD.md.
CRON_SECRET=""
