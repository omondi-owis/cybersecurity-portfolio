# =====================================================================
# PORTFOLIO CONFIGURATION — copy to .env and fill with REAL values only.
# NEVER invent URLs. Leave a value empty to hide that link gracefully.
# NEVER commit .env to git.
# =====================================================================

# --- Identity ---
NEXT_PUBLIC_OWNER_NAME="Omondi Raphael Owino"
NEXT_PUBLIC_OWNER_TITLE="Cybersecurity & Network Security Engineer"
NEXT_PUBLIC_SITE_URL="https://example.com"

# --- Contact (leave empty if unavailable — the UI hides it) ---
CONTACT_EMAIL=""
NEXT_PUBLIC_GITHUB_URL=""
NEXT_PUBLIC_LINKEDIN_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""
NEXT_PUBLIC_TIKTOK_URL=""
NEXT_PUBLIC_WHATSAPP_URL=""
NEXT_PUBLIC_CV_URL=""

# --- Contact form delivery (optional) ---
# Option A: no backend delivery — form validates and shows a "copy my message"
# fallback so visitors can email you directly. Works with zero secrets.
# Option B: set RESEND_API_KEY + CONTACT_TO_EMAIL to enable server delivery.
# NEVER prefix server secrets with NEXT_PUBLIC_.
CONTACT_TO_EMAIL=""
RESEND_API_KEY=""

# --- Optional: GitHub data (server-side only, cached, never exposed) ---
# If empty, the site renders static project data with zero external calls.
GITHUB_TOKEN=""
